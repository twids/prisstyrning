{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=prisstyrning;Username=prisstyrning;Password=prisstyrning"
  },
  "Daikin": {
    "AccessToken": "ACCESS_TOKEN",
    "ClientId":"CLIENT_ID",
    "ClientSecret":"CLIENT_SECRET",
    "ApiBaseUrl": "https://api.onecta.daikineurope.com"
  },
  "Schedule": {
    "ComfortHours": 3,
    "TurnOffPercentile": 0.9,
    "MaxComfortGapHours": 28,
    "MaxActivationsPerDay": 4,
    "TurnOffSpikeDeltaPct": 10,
    "TurnOffNeighborWindow": 2,
    "ComfortNextHourMaxIncreasePct": 25,
    "HistoryRetentionDays": 30
  },
  "Storage": {
    "Directory": "data"
  },
  "Security": {
    "AcceptLegacyUserCookie": false
  },
  "Thermal": {
    "EnableDhwWriterCoordination": false,
    "AllowLwtActive": false,
    "AllowFullActive": false
  },
  "HomeAssistant": {
    "Telemetry": {
      "Enabled": false,
      "BaseUrl": "",
      "StaleAfterMinutes": 10
    },
    "Control": {
      "BaseUrl": "",
      "HeatingDeviationEntityId": ""
    }
  },
  "Emhass": {
    "Enabled": false,
    "BaseUrl": "http://emhass:5000",
    "ResultPath": "/emhass-data/opt_res_latest.csv",
    "SolverTimeoutSeconds": 45,
    "OptimizationTimeStepMinutes": 15,
    "HorizonHours": 48
  },
  "Price": {
    "RetentionDays": 90,
    "Nordpool": {
      "DefaultZone": "SE3",
      "Currency": "SEK"
    }
  }
}

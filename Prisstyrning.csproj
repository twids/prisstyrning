<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Controllers/**/*.cs" />
    <Compile Include="Data/**/*.cs" />
    <Compile Include="Jobs/**/*.cs" />
    <Compile Include="Properties/**/*.cs" />
    <Compile Include="Thermal/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Prisstyrning.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Release builds pass the exact source commit explicitly. Keep the value in
    assembly metadata so model provenance is bound to the running binary rather
    than to mutable runtime configuration.
  -->
  <Target Name="GeneratePrisstyrningSourceRevision" BeforeTargets="CoreCompile">
    <Error Condition="'$(PrisstyrningRequireSourceRevision)' == 'true' and '$(PrisstyrningSourceRevision)' == ''"
           Text="PrisstyrningSourceRevision is required for this build." />
    <Error Condition="'$(PrisstyrningSourceRevision)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(PrisstyrningSourceRevision)', '^(?!0+$)[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$'))"
           Text="PrisstyrningSourceRevision must be a 40- or 64-character hexadecimal commit identifier." />
    <ItemGroup Condition="'$(PrisstyrningSourceRevision)' != ''">
      <_PrisstyrningSourceRevisionAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Prisstyrning.SourceRevision</_Parameter1>
        <_Parameter2>$(PrisstyrningSourceRevision)</_Parameter2>
      </_PrisstyrningSourceRevisionAttribute>
    </ItemGroup>
    <WriteCodeFragment Condition="'$(PrisstyrningSourceRevision)' != ''"
                       Language="C#"
                       OutputFile="$(IntermediateOutputPath)Prisstyrning.SourceRevision.g.cs"
                       AssemblyAttributes="@(_PrisstyrningSourceRevisionAttribute)">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
    </WriteCodeFragment>
  </Target>

  <ItemGroup>
  <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  <PackageReference Include="Hangfire.Core" Version="1.8.25" />
  <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
  <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
  <!-- Hangfire supports newer Json.NET versions; pin the patched stable release instead of its old minimum. -->
  <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    <PrivateAssets>all</PrivateAssets>
  </PackageReference>
  <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="appsettings.development.json" Condition="Exists('appsettings.development.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot-v2/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
